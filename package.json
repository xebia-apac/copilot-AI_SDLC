    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.14.4",
    "@types/supertest": "^2.0.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.4",
    "jest": "^29.7.0",
    "prettier": "^3.1.4",
    "supertest": "^6.3.3",
