generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DEVELOPER
  TEAM_LEAD
  PROJECT_MANAGER
  QA_ENGINEER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(DEVELOPER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasks        Task[]   @relation("AssigneeTasks")
  history      TaskStatusHistory[]
}

model Task {
  id                     String               @id @default(uuid())
  taskKey                String               @unique
  title                  String
  description            String?
  priority               Priority             @default(MEDIUM)
  status                 TaskStatus           @default(TODO)
  estimatedCompletionDate DateTime?
  assignee               User?                @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  assigneeId             String?
  dependencies           TaskDependency[]     @relation("TaskDependencies")
  dependents             TaskDependency[]     @relation("DependentTasks")
  statusHistory          TaskStatusHistory[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model TaskDependency {
  id             String @id @default(uuid())
  task           Task   @relation("TaskDependencies", fields: [taskId], references: [id])
  taskId         String
  dependsOn      Task   @relation("DependentTasks", fields: [dependsOnTaskId], references: [id])
  dependsOnTaskId String
  createdAt      DateTime @default(now())
  @@unique([taskId, dependsOnTaskId])
}

model TaskStatusHistory {
  id           String      @id @default(uuid())
  task         Task        @relation(fields: [taskId], references: [id])
  taskId       String
  previousStatus TaskStatus
  newStatus    TaskStatus
  changedBy    User        @relation(fields: [changedById], references: [id])
  changedById  String
  changedAt    DateTime    @default(now())
  note         String?
}
